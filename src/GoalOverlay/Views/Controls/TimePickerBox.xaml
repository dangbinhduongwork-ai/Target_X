<UserControl x:Class="GoalOverlay.Views.Controls.TimePickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TimeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="QuickPresetButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PresetBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PresetBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="PresetBorder" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearTimeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearBorder" Property="Background" Value="#332126"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="6,4">
        <StackPanel Orientation="Vertical">
            <!-- Hàng 1: Chọn giờ : phút và nút xóa -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🕒" FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <!-- ComboBox Giờ (00 - 23) -->
                <ComboBox x:Name="CmbHour" Style="{StaticResource TimeComboBoxStyle}" Width="48"
                          SelectionChanged="CmbTime_SelectionChanged"
                          ToolTip="Chọn giờ (00-23)"/>

                <TextBlock Text=":" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="3,0,3,0"/>

                <!-- ComboBox Phút (00 - 59, bước 5, cho gõ tay) -->
                <ComboBox x:Name="CmbMinute" Style="{StaticResource TimeComboBoxStyle}" Width="52"
                          IsEditable="True"
                          SelectionChanged="CmbTime_SelectionChanged"
                          TextBoxBase.TextChanged="CmbMinute_TextChanged"
                          ToolTip="Chọn hoặc gõ phút (00-59)"/>

                <!-- Nút Xóa giờ -->
                <Button x:Name="BtnClear" Style="{StaticResource ClearTimeButton}" Content="✕" Margin="5,0,0,0"
                        Click="BtnClear_Click" ToolTip="Xóa hẹn giờ"/>
            </StackPanel>

            <!-- Hàng 2: 3 nút phím tắt nhanh (+15 phút, +1 giờ, 20:00) -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource QuickPresetButton}" Content="+15m" Click="BtnPlus15m_Click" ToolTip="Hẹn sau 15 phút nữa"/>
                <Button Style="{StaticResource QuickPresetButton}" Content="+1h" Click="BtnPlus1h_Click" ToolTip="Hẹn sau 1 giờ nữa"/>
                <Button Style="{StaticResource QuickPresetButton}" Content="20:00" Click="Btn2000_Click" ToolTip="Hẹn vào lúc 20:00 tối"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
