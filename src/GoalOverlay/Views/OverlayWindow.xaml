<Window x:Class="GoalOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GoalOverlay.Models"
        xmlns:vm="clr-namespace:GoalOverlay.ViewModels"
        mc:Ignorable="d"
        Title="GoalOverlay HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Hiệu ứng bóng đổ nền HUD tổng thể -->
        <DropShadowEffect x:Key="CardDropShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>

        <!-- Hiệu ứng bóng đổ nhẹ cho chữ để đọc rõ trên mọi nền sáng hoặc tối -->
        <DropShadowEffect x:Key="TextDropShadow" BlurRadius="3" ShadowDepth="1.2" Direction="315" Color="#000000" Opacity="0.95"/>

        <!-- Nút tick chọn tròn tinh tế -->
        <Style x:Key="GoalToggleCheckButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBorder" Width="16" Height="16" CornerRadius="8"
                                BorderBrush="#64748B" BorderThickness="1.6" Background="Transparent" Margin="0,1,8,0">
                            <Path x:Name="CheckSign" Data="M3,8 L6,11 L13,4" Stroke="White" StrokeThickness="1.8"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="CircleBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="CircleBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="CheckSign" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Nút icon nhỏ trên thanh tiêu đề HUD -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho ContextMenu chuẩn Dark HUD -->
        <Style x:Key="HudContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- 1. GIAO DIỆN MỞ RỘNG (EXPANDED HUD - CHẾ ĐỘ MẶC ĐỊNH) -->
        <Border x:Name="ExpandedCard"
                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                MinWidth="260"
                MaxWidth="380"
                Background="#D90F172A"
                Opacity="{Binding Opacity}"
                CornerRadius="14"
                BorderBrush="#334155"
                BorderThickness="1.2"
                Effect="{StaticResource CardDropShadow}"
                MouseLeftButtonDown="Border_MouseLeftButtonDown"
                ToolTip="Nhấp đúp để mở Quản lý mục tiêu | Chuột phải để mở menu tùy chọn">
            <Border.ContextMenu>
                <ContextMenu Style="{StaticResource HudContextMenuStyle}">
                    <MenuItem Header="🎯 Mở quản lý mục tiêu (Ctrl+Alt+M)" Click="OpenManagement_Click"/>
                    <MenuItem Header="➕ Thêm mục tiêu hôm nay" Click="AddDailyGoal_Click"/>
                    <MenuItem Header="📅 Thêm mục tiêu tháng này" Click="AddMonthlyGoal_Click"/>
                    <MenuItem Header="⚙️ Cài đặt giao diện" Click="OpenSettings_Click"/>
                    <Separator Background="#334155"/>
                    <MenuItem Header="➖ Thu nhỏ thành nút tròn nổi" Command="{Binding ToggleCollapseCommand}"/>
                    <MenuItem Header="👁️ Ẩn Overlay (Ctrl+Alt+G)" Click="ToggleOverlay_Click"/>
                    <MenuItem Header="❌ Thoát ứng dụng" Click="ExitApp_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề HUD kèm nút Quản lý & Thêm mục tiêu & Thu nhỏ -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Cursor="Hand"
                                MouseDown="HeaderTitle_MouseDown"
                                ToolTip="Nhấp đúp chuột hoặc bấm Ctrl+Alt+M để mở Quản lý mục tiêu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MỤC TIÊU" FontWeight="Bold" FontSize="12.5" Foreground="#60A5FA"
                                       Effect="{StaticResource TextDropShadow}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Ctrl + Alt + M để thêm/sửa" FontSize="9.5" Foreground="#64748B" Margin="20,1,0,0"
                                   Effect="{StaticResource TextDropShadow}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Thêm mục tiêu / Mở quản lý -->
                        <Button Style="{StaticResource HeaderIconButton}"
                                ToolTip="Mở Quản lý mục tiêu (Ctrl+Alt+M)"
                                Click="OpenManagement_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Cài đặt -->
                        <Button Style="{StaticResource HeaderIconButton}"
                                Margin="5,0,0,0"
                                ToolTip="Cài đặt HUD"
                                Click="OpenSettings_Click">
                            <TextBlock Text="⚙️" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Nút Thu nhỏ thành nút tròn nổi iPhone Home -->
                        <Button Style="{StaticResource HeaderIconButton}"
                                Margin="5,0,0,0"
                                ToolTip="Thu nhỏ thành nút tròn nổi (như phím Home iPhone)"
                                Command="{Binding ToggleCollapseCommand}">
                            <TextBlock Text="➖" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

            <!-- 1. KHỐI HÔM NAY (kèm tiến độ x/y xong) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8"
                        Visibility="{Binding HasTodayGoals, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                               Effect="{StaticResource TextDropShadow}"/>
                    <TextBlock Text="{Binding TodayProgressText}" FontSize="10.5" Foreground="#64748B" Margin="6,0,0,0"
                               VerticalAlignment="Center" Effect="{StaticResource TextDropShadow}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding TodayGoals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GoalItemViewModel}">
                            <Grid Margin="0,3,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nút toggle hoàn thành -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource GoalToggleCheckButton}"
                                        Command="{Binding DataContext.ToggleGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center"/>

                                <!-- Giờ hẹn dạng "20:30" trước tên mục tiêu kèm màu trạng thái -->
                                <Border Grid.Column="1"
                                        Visibility="{Binding HasDueTime, Converter={StaticResource BoolToVis}}"
                                        Background="#220F172A"
                                        BorderBrush="{Binding StatusColor}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="BorderBrush" Value="#475569"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DueTimeString}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding StatusColor}"
                                               Effect="{StaticResource TextDropShadow}"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text mục tiêu: gạch ngang và mờ hơn khi đã xong -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Text}"
                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding DataContext.TextColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Effect="{StaticResource TextDropShadow}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Đường phân cách nhẹ giữa 2 khối -->
            <Separator Grid.Row="2" Background="#1E293B" Margin="0,4,0,8"
                       Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}"/>

            <!-- 2. KHỐI THÁNG NÀY (kèm tiến độ x/y xong) -->
            <StackPanel Grid.Row="3"
                        Visibility="{Binding HasMonthGoals, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="THÁNG NÀY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                               Effect="{StaticResource TextDropShadow}"/>
                    <TextBlock Text="{Binding MonthProgressText}" FontSize="10.5" Foreground="#64748B" Margin="6,0,0,0"
                               VerticalAlignment="Center" Effect="{StaticResource TextDropShadow}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding MonthGoals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GoalItemViewModel}">
                            <Grid Margin="0,3,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource GoalToggleCheckButton}"
                                        Command="{Binding DataContext.ToggleGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center"/>

                                <!-- Badge hạn chót / giờ hẹn cho mục tiêu tháng -->
                                <Border Grid.Column="1"
                                        Visibility="{Binding HasDueTime, Converter={StaticResource BoolToVis}}"
                                        Background="#220F172A"
                                        BorderBrush="{Binding StatusColor}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="BorderBrush" Value="#475569"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DueTimeString}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding StatusColor}"
                                               Effect="{StaticResource TextDropShadow}"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Text}"
                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding DataContext.TextColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Effect="{StaticResource TextDropShadow}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Dòng chữ bé ở chính giữa khi không có mục tiêu gì -->
            <Border Grid.Row="1" Grid.RowSpan="3"
                    Visibility="{Binding HasNoGoals, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="12,18"
                    Cursor="Hand"
                    MouseDown="EmptyState_MouseDown"
                    ToolTip="Nhấp chuột hoặc bấm Ctrl+Alt+M để mở Quản lý mục tiêu">
                <TextBlock Text="Hiện tại đang không có mục tiêu gì"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Effect="{StaticResource TextDropShadow}"/>
            </Border>

            <!-- 3. DÒNG CHỮ NHỎ HƯỚNG DẪN MỞ GIAO DIỆN THÊM MỤC TIÊU -->
            <Border Grid.Row="4" Margin="0,10,0,0" Padding="0,6,0,0" BorderBrush="#253347" BorderThickness="0,1,0,0">
                <TextBlock Text="⌨️ Nhấn Ctrl + Alt + M để mở thêm mục tiêu"
                           FontSize="10"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Effect="{StaticResource TextDropShadow}"/>
            </Border>
        </Grid>
    </Border>

        <!-- 2. NÚT TRÒN NỔI IPHONE HOME (ASSISTIVETOUCH) KHI THU NHỎ -->
        <Border x:Name="CollapsedCard"
                Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}"
                Width="48" Height="48"
                CornerRadius="24"
                Opacity="{Binding Opacity}"
                BorderThickness="1.5"
                Effect="{StaticResource CardDropShadow}"
                Cursor="Hand"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                PreviewMouseLeftButtonDown="CollapsedHomeButton_PreviewMouseLeftButtonDown"
                PreviewMouseMove="CollapsedHomeButton_PreviewMouseMove"
                PreviewMouseLeftButtonUp="CollapsedHomeButton_PreviewMouseLeftButtonUp"
                ToolTip="🎯 GoalOverlay (Đang thu nhỏ)&#x0a;👉 Bấm chuột trái: Mở rộng về vị trí ban đầu&#x0a;🖐️ Giữ &amp; Kéo: Di chuyển tự do trên màn hình&#x0a;🖱️ Chuột phải: Menu tùy chọn">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E60F172A"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F21E293B"/>
                            <Setter Property="BorderBrush" Value="#67E8F9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.ContextMenu>
                <ContextMenu Style="{StaticResource HudContextMenuStyle}">
                    <MenuItem Header="📖 Mở rộng Overlay" Command="{Binding ToggleCollapseCommand}"/>
                    <MenuItem Header="🎯 Quản lý mục tiêu (Ctrl+Alt+M)" Click="OpenManagement_Click"/>
                    <MenuItem Header="⚙️ Cài đặt giao diện" Click="OpenSettings_Click"/>
                    <Separator Background="#334155"/>
                    <MenuItem Header="👁️ Ẩn Overlay (Ctrl+Alt+G)" Click="ToggleOverlay_Click"/>
                    <MenuItem Header="❌ Thoát ứng dụng" Click="ExitApp_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <!-- Vòng tròn phụ phong cách phím Home / AssistiveTouch -->
                <Border Width="34" Height="34" CornerRadius="17"
                        BorderBrush="#4038BDF8" BorderThickness="1.2"
                        Background="#1A38BDF8"/>
                <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Effect="{StaticResource TextDropShadow}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
