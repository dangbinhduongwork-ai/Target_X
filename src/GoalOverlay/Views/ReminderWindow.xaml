<Window x:Class="GoalOverlay.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoalOverlay.ViewModels"
        mc:Ignorable="d"
        Title="GoalOverlay - Nhắc Nhở Mục Tiêu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Hiệu ứng bóng đổ nổi bật -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.75"/>
        <DropShadowEffect x:Key="TextShadow" BlurRadius="3" ShadowDepth="1.2" Direction="315" Color="#000000" Opacity="0.8"/>

        <!-- Nút Hoàn thành (Emerald Green) -->
        <Style x:Key="CompleteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Nhắc lại sau (Snooze) -->
        <Style x:Key="SnoozeBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#334155"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Bỏ qua (Dismiss) -->
        <Style x:Key="DismissBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3B1318"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ContextMenu chọn phút Snooze -->
        <Style x:Key="SnoozeContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </Window.Resources>

    <!-- Khung Card Nhắc nhở chính -->
    <Border Margin="18"
            MinWidth="450"
            MaxWidth="560"
            Background="#F2111827"
            CornerRadius="14"
            BorderBrush="#38BDF8"
            BorderThickness="1.6"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="20,18,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="NHẮC NHỞ MỤC TIÊU" FontWeight="Bold" FontSize="14.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TitleCountText}" FontSize="12.5" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Đường phân cách nhẹ -->
            <Separator Grid.Row="1" Background="#1F2937" Margin="0,0,0,14"/>

            <!-- Danh sách các mục tiêu đến hạn -->
            <ScrollViewer Grid.Row="2" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReminderGoalItemViewModel}">
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Hàng 1: Text mục tiêu -->
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#F8FAFC"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Effect="{StaticResource TextShadow}"/>

                                    <!-- Hàng 2: Badges giờ hẹn & quá hạn -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                                        <!-- Badge giờ hẹn -->
                                        <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🕒" FontSize="10.5" Margin="0,0,4,0" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DueTimeString}" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Badge cảnh báo quá hạn -->
                                        <Border Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}"
                                                Background="#3B1318" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠️" FontSize="10.5" Margin="0,0,4,0" Foreground="#EF4444" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding OverdueText}" FontSize="11.5" FontWeight="Bold" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Hàng 3: 3 Nút hành động -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Nút Hoàn thành -->
                                        <Button Content="✓ Đã hoàn thành"
                                                Style="{StaticResource CompleteBtnStyle}"
                                                Command="{Binding CompleteCommand}"
                                                ToolTip="Đánh dấu đã hoàn thành mục tiêu này ngay"/>

                                        <!-- Nút Nhắc lại sau (Snooze Menu) -->
                                        <Button Content="⏰ Nhắc lại sau ▾"
                                                Style="{StaticResource SnoozeBtnStyle}"
                                                Margin="8,0,0,0"
                                                Click="SnoozeButton_Click"
                                                ToolTip="Hoãn nhắc lại sau một khoảng thời gian">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource SnoozeContextMenuStyle}">
                                                    <MenuItem Header="⏰ Sau 5 phút" Command="{Binding SnoozeCommand}" CommandParameter="5"/>
                                                    <MenuItem Header="⏰ Sau 10 phút" Command="{Binding SnoozeCommand}" CommandParameter="10"/>
                                                    <MenuItem Header="⏰ Sau 30 phút" Command="{Binding SnoozeCommand}" CommandParameter="30"/>
                                                    <MenuItem Header="⏰ Sau 60 phút (1 giờ)" Command="{Binding SnoozeCommand}" CommandParameter="60"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>

                                        <!-- Nút Bỏ qua -->
                                        <Button Content="✕ Bỏ qua"
                                                Style="{StaticResource DismissBtnStyle}"
                                                Margin="8,0,0,0"
                                                Command="{Binding DismissCommand}"
                                                ToolTip="Bỏ qua lời nhắc cho lần hẹn này"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
